{
  "entities": {
    "Task": {
      "title": "Study Task",
      "description": "A specific study item or assignment",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "completed": { "type": "boolean" },
        "dueDate": { "type": "string", "format": "date-time" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "subject", "completed"]
    },
    "StudySession": {
      "title": "Study Session",
      "description": "A record of time spent studying",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "performanceScore": { "type": "number" }
      },
      "required": ["userId", "subject", "durationMinutes", "date"]
    }
  },
  "firestore": {
    "tasks": {
      "schema": "Task",
      "description": "Collection of tasks for each user"
    },
    "sessions": {
      "schema": "StudySession",
      "description": "History of study sessions for progress tracking"
    }
  }
}
